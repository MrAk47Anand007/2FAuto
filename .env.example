# Temporary compatibility only: API key for legacy routes when enabled below
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-strong-random-api-key

# Required: Base32-encoded TOTP secret (must match the secret in your authenticator app)
# Generate with: python -c "import pyotp; print(pyotp.random_base32())"
OTP_SECRET=your-totp-base32-secret-key

# Runtime profile: development, test, or production
APP_ENV=development

# Server bind address (default: 0.0.0.0)
HOST=0.0.0.0

# Server port (default: 8000)
PORT=8000

# Set to true to enable Swagger UI at /docs (disable in production)
ENABLE_DOCS=true

# Set true behind HTTPS in production. Production startup refuses false.
COOKIE_SECURE=false

# Required: URL-safe base64 encoding of a random 32-byte AES-GCM key.
# Generate with: python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SECRET_ENCRYPTION_KEY=change-this-encryption-key
SECRET_ENCRYPTION_KEY_VERSION=v1
# Optional JSON map of retained old key versions during rotation.
SECRET_ENCRYPTION_KEYS=

# Temporary migration compatibility only; keep false for new deployments.
LEGACY_API_ENABLED=false
CLIENT_RATE_LIMIT_PER_MINUTE=60

# SQLite database path for users and portal OTP secrets
DATABASE_PATH=otp_service.db

# Required for signing browser login sessions
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-this-session-secret

# First admin account bootstrapped on startup when missing
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
