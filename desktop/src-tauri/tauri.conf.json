{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "2FAuto",
  "version": "0.1.0",
  "identifier": "com.twofauto.desktop",
  "build": { "frontendDist": "../status" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'" }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/twofauto-runtime"],
    "targets": ["msi"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
