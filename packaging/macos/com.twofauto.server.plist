<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.twofauto.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/lib/2fauto/twofauto-runtime</string>
    <string>serve</string>
    <string>--config</string>
    <string>/Library/Application Support/2FAuto/runtime.json</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>UserName</key><string>root</string>
  <key>StandardOutPath</key><string>/Library/Logs/2FAuto/server.log</string>
  <key>StandardErrorPath</key><string>/Library/Logs/2FAuto/server-error.log</string>
</dict>
</plist>
